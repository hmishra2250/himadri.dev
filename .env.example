# Copy this file to .env.local and fill real values locally or in Vercel.
# Do not commit real secrets.

# Google Analytics 4 events. Analytics stays off unless all three are set.
# The measurement ID is browser-visible by design, for example G-XXXXXXXXXX.
ENABLE_ANALYTICS=0
NEXT_PUBLIC_ANALYTICS_PROVIDER=google_analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
