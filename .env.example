# Copy this file to .env.local and fill real values locally or in Vercel.
# Do not commit real secrets.

# Feature gates
ENABLE_INTERVIEW_ASSISTANT_API=0
ENABLE_GEMINI_ASSISTANT=0
ENABLE_ANALYTICS=0

# Gemini assistant, server only
# Never prefix this key with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=768
GEMINI_TEMPERATURE=0.2

# Google Analytics 4 events
# Browser-visible by design. Fill with a GA4 measurement ID such as G-XXXXXXXXXX.
NEXT_PUBLIC_ANALYTICS_PROVIDER=google_analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
