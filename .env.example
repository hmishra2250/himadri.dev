# Copy this file to .env.local and fill real values locally or in Vercel.
# Do not commit real secrets.

# Feature gates
ENABLE_INTERVIEW_ASSISTANT_API=0
ENABLE_GEMINI_ASSISTANT=0
ENABLE_ANALYTICS=0
ENABLE_OBSERVABILITY=0

# Gemini assistant, server only
# Never prefix this key with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=768
GEMINI_TEMPERATURE=0.2

# Optional analytics provider: none, vercel, plausible, or posthog
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional Sentry observability
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0
