{
  "name": "himadri-dev-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-first portfolio for senior AI/platform engineering roles.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:routes": "tsx scripts/validate-routes.ts",
    "test:links": "tsx scripts/check-links.ts",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run validate:content && npm run build:assistant-corpus && npm run validate:assistant-corpus && npm run eval:assistant && npm run validate:routes && npm run validate:confidentiality && npm run validate:structured-data && npm run build && npm run test:links && npm run test:routes-smoke && npm run test:api",
    "validate:confidentiality": "tsx scripts/validate-confidentiality.ts",
    "test:routes-smoke": "tsx scripts/test-routes-smoke.ts",
    "build:assistant-corpus": "tsx scripts/build-assistant-corpus.ts",
    "validate:assistant-corpus": "tsx scripts/validate-assistant-corpus.ts",
    "eval:assistant": "tsx scripts/eval-assistant.ts",
    "test:api": "tsx scripts/test-api.ts",
    "validate:structured-data": "tsx scripts/validate-structured-data.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tailwindcss": "latest"
  },
  "devDependencies": {
    "@eslint/eslintrc": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "prettier": "latest",
    "tsx": "latest",
    "typescript": "latest"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
